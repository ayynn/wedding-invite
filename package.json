{
  "name": "wedding-invite",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "GMY & WJ 婚礼邀请函 · Vue3 + TypeScript + Vite 工程化项目",
  "scripts": {
    "dev": "vite",
    "dev:cloud": "vite --mode cloud",
    "build": "vue-tsc -b && vite build",
    "build:web": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "mock": "node scripts/mock-server.mjs",
    "share:qr": "node scripts/generate-share-qr.mjs",
    "typecheck": "vue-tsc --noEmit",
    "deploy": "node scripts/deploy-cloudbase.mjs",
    "deploy:cloudbase": "node scripts/deploy-cloudbase.mjs"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "photoswipe": "^5.4.4",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^5.2.1",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.3",
    "typescript": "~5.6.2",
    "vite": "^6.0.7",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^2.1.10"
  }
}
